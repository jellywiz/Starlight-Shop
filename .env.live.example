# Starlight Jewellery — LIVE site credentials for maintainer commands (pnpm *:live).
# Copy to .env.live (git-ignored) and fill in. Only scripts/live.sh reads it; the website,
# `pnpm dev`, tests and builds never do. Step-by-step: docs/deployment.md, section
# "Maintainer commands against the live site".
#
# Keep .env.live on the maintainer's Mac only: never commit it, paste it into chat, or put
# it in a synced/shared folder. Quote values that contain special characters.

# Supabase → Project Settings → Database → Connect → Session pooler (port 5432).
# Includes the database password.
DATABASE_MIGRATION_URI='postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres'

# Same values as the Netlify environment variables of the same name.
S3_ENDPOINT='https://<project-ref>.storage.supabase.co/storage/v1/s3'
S3_REGION='<region>'
S3_BUCKET='product-images'
MEDIA_PUBLIC_BASE_URL='https://<project-ref>.supabase.co/storage/v1/object/public/product-images'

# Supabase → Storage → S3 connection → Access keys. Use a separate key pair named
# "maintainer-mac" so it can be revoked without touching the live site's key.
S3_ACCESS_KEY_ID='<access-key-id>'
S3_SECRET_ACCESS_KEY='<secret-access-key>'

# Optional: makes "Sign in at …" messages show the live address instead of localhost.
SITE_URL='https://starlight-jewellery.netlify.app'
