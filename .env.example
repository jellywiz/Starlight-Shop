# Starlight Jewellery — environment contract (spec section 14).
# Copy to .env for local development. NEVER commit real secrets; production values live
# in the Netlify site settings, not in this repository.

# --- Application -----------------------------------------------------------------
# Canonical HTTPS origin of the public site (no trailing slash).
# Local: http://localhost:3000   Production: https://starlight-jewellery.netlify.app
SITE_URL=http://localhost:3000

# Strong random secret for Payload authentication (32+ characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Database (PostgreSQL) ------------------------------------------------------
# Local development uses the embedded PostgreSQL started by `pnpm dev` / `pnpm db:start`;
# the cluster is created with the user, password and database named here.
DATABASE_URI=postgres://starlight:starlight-local-dev@127.0.0.1:54329/starlight_jewellery
LOCAL_PG_PORT=54329

# Production (Supabase): runtime uses the TRANSACTION pooler (port 6543, IPv4-compatible).
# DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations use the SESSION pooler (port 5432). Only the maintainer's machine gets this
# value; it is never stored in Netlify.
# DATABASE_MIGRATION_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Image storage (Supabase Storage via S3 protocol) ----------------------------
# Leave these empty locally: files are stored on disk under ./media (development only).
# In production every value is required.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL used to build image links, e.g.
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
MEDIA_PUBLIC_BASE_URL=

# --- Optional switches ------------------------------------------------------------
# Password reset by email stays disabled until an email provider is configured.
ENABLE_PASSWORD_RESET=false
